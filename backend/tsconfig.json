{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
 "baseUrl": "./src",
    "paths": {
      "@interfaces/*": ["interfaces/*"],
      "@infrastructure/*": ["infrestructure/*"],
      "@models/*": ["infrestructure/orm/models/*"],
      "@routes/*": ["interfaces/routes/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
